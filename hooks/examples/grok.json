{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B /absolute/path/to/barline/hooks/stop.py native --client grok --binding /external/grok-binding.json --timeout 5",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B /absolute/path/to/barline/hooks/stop.py native --client grok --binding /external/grok-binding.json --timeout 5",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
