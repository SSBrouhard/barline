{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B /absolute/path/to/lean-harness/hooks/stop.py native --client claude --binding /external/claude-binding.json --timeout 5",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B /absolute/path/to/lean-harness/hooks/stop.py native --client claude --binding /external/claude-binding.json --timeout 5",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
